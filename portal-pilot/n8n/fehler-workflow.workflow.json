      "onError": "continueRegularOutput"
    },
    {
      "id": "1e3572d7-f526-4f47-a03c-21d68096b8c8",
      "name": "Bisherige Notiz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://HIER_SUPABASE_PROJEKT.supabase.co/rest/v1/team_notizen?select=inhalt&notiz_id=eq.{{ encodeURIComponent($('Störung vorbereiten').first().json.notiz_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "name": "Supabase (Pilot)"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "40114dbb-0440-4e69-a857-f61e554879c3",
      "name": "Notiz bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Baut die Störungs-Notiz: hängt den neuen Abschnitt an die Notiz des Tages an (falls es schon eine gibt) und legt sie in das erste Projekt des Admins.\nconst v = $('Störung vorbereiten').first().json;\nconst admin = $('Admin suchen').first().json || {};\nif (!admin.mitglied_id) throw new Error('Im Team gibt es keinen Admin: Störungs-Notiz nicht geschrieben.');\nconst proj = $('Projekt des Admins').first().json || {};\nconst alt = $('Bisherige Notiz').first().json || {};\nconst jetzt = new Date().toISOString();\nlet inhalt = (alt.inhalt ? String(alt.inhalt) + '\\n\\n' : 'Automatische Störungsmeldungen des Portals. Neueste unten.\\n\\n') + v.block;\nif (inhalt.length > 40000) inhalt = inhalt.slice(-40000);\nconst body = { notiz_id: v.notiz_id, titel: v.titel, inhalt, projekt: proj.name || '', geaendert_von: admin.mitglied_id, geaendert: jetzt };\nif (!alt.inhalt) { body.autor = admin.mitglied_id; body.erstellt = jetzt; }\nconst email = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(String(admin.email || '')) ? String(admin.email).trim() : '';\nreturn [{ json: { pfad: 'team_notizen?on_conflict=notiz_id', body, an: email, betreff: 'Störung im Team-Portal: ' + v.workflow, text: 'Im Team-Portal gab es eine Störung.\\n\\nWorkflow: ' + v.workflow + '\\nKnoten: ' + v.knoten + '\\nUm: ' + v.datum + ' ' + v.uhr + ' Uhr\\nMeldung: ' + v.meldung + '\\n\\nDie Notiz „' + v.titel + '“ im Portal enthält dieselben Angaben.' } }];\n"
      }
    },
    {
      "id": "687f2333-00a4-4edf-aa2a-c4d794d8ae4f",
      "name": "Notiz schreiben",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        -96
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://HIER_SUPABASE_PROJEKT.supabase.co/rest/v1/' + $json.pfad }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "name": "Supabase (Pilot)"
        }
      }
    },
    {
      "id": "05ac909d-c57b-465c-abcd-d1c9fa3667c1",
