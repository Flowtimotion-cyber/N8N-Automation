{
  "name": "PORTAL: Fehler-Workflow (Pilot)",
  "nodes": [
    {
      "id": "fb3d50b1-c428-450a-a850-5b658767aa27",
      "name": "Fehler-Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "a70e28ed-b314-4587-a868-d43bb3dfd5cc",
      "name": "Störung vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Macht aus der Fehlermeldung von n8n einen kurzen Abschnitt für die Störungs-Notiz. Keine Ausführungsdaten, keine Stacktraces.\nconst e = $input.first().json || {};\nconst ex = e.execution || {};\nconst fehler = (ex.error || (e.trigger && e.trigger.error) || {});\nconst wf = (e.workflow && e.workflow.name) || 'unbekannter Workflow';\nconst knoten = ex.lastNodeExecuted || '–';\nconst meldung = String(fehler.message || 'keine Meldung').replace(/\\s+/g, ' ').trim().slice(0, 300);\nconst jetzt = new Date();\nconst datum = jetzt.toLocaleDateString('de-DE', { timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit', year: 'numeric' });\nconst tagId = jetzt.toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' }).replace(/-/g, '');\nconst uhr = jetzt.toLocaleTimeString('de-DE', { timeZone: 'Europe/Berlin', hour: '2-digit', minute: '2-digit' });\nconst block = '### ' + uhr + ' Uhr – ' + wf + '\\n- Knoten: ' + knoten + '\\n- Meldung: ' + meldung + '\\n- Ausführung in n8n: ' + (ex.id || '–') + '\\n- Was tun: In n8n bei diesem Workflow unter „Ausführungen“ nachsehen. Aus Datenschutzgründen werden dort keine Daten gespeichert; die Meldung oben ist der Hinweis.';\nreturn [{ json: { notiz_id: 'n_stoerung_' + tagId, titel: 'Störung ' + datum, datum, uhr, workflow: wf, knoten, meldung, block } }];\n"
      }
    },
    {
      "id": "84d5ddca-3d62-4579-ab37-2f1c73c15742",
      "name": "Admin suchen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://HIER_SUPABASE_PROJEKT.supabase.co/rest/v1/team_mitglieder?select=mitglied_id,name,email&rolle=eq.admin&status=neq.gesperrt&order=mitglied_id.asc&limit=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "name": "Supabase (Pilot)"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "1f7e62c6-7406-4861-aa34-018df5d9d8a8",
      "name": "Projekt des Admins",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://HIER_SUPABASE_PROJEKT.supabase.co/rest/v1/team_projekte?select=name&verantwortlich=eq.{{ encodeURIComponent($json.mitglied_id || '') }}&order=reihenfolge.asc&limit=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 20000,
          "response": {
